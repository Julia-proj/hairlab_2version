---
import { hairlab } from '../data/hairlab';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
---

<Section alt id="author">
  <Container class="author__grid">
    <div class="author__media">
      {hairlab.author.images.map((image, index) => (
        <figure class={`author__photo author__photo--${index + 1}`}>
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            width={image.width}
            height={image.height}
          />
        </figure>
      ))}
      <figure class="author__photo author__photo--3">
        <img
          src={hairlab.author.studio.src}
          alt={hairlab.author.studio.alt}
          loading="lazy"
          width={hairlab.author.studio.width}
          height={hairlab.author.studio.height}
        />
      </figure>
    </div>
    <div>
      <p class="eyebrow">
        {hairlab.author.eyebrow}
      </p>
      <h2 class="h2">
        {hairlab.author.name}
      </h2>
      {hairlab.author.paragraphs.map((paragraph) => (
        <p class="body author__p">
          {paragraph}
        </p>
      ))}
      <div class="author__stats">
        {hairlab.author.stats.map((stat) => (
          <div class="author__stat">
            <span class="author__stat-value">{stat.value}</span>
            <span class="author__stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
      <ul class="author__list">
        {hairlab.author.list.map((item) => (
          <li>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</Section>
