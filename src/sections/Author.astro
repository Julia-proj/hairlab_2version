---
import { hairlab } from '../data/hairlab';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
---

<Section alt id="author">
  <Container class="author__grid">
    <div>
      <img
        src={hairlab.author.image.src}
        alt={hairlab.author.image.alt}
        loading="lazy"
        width="500"
        height="600"
      />
    </div>
    <div>
      <p class="eyebrow">
        {hairlab.author.eyebrow}
      </p>
      <h2 class="h2">
        {hairlab.author.name}
      </h2>
      {hairlab.author.paragraphs.map((paragraph) => (
        <p class="body author__p">
          {paragraph}
        </p>
      ))}
      <ul class="author__list">
        {hairlab.author.list.map((item) => (
          <li>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</Section>
