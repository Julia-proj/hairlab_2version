---
import { hairlab } from '../data/hairlab';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
---

<Section alt>
  <Container>
    <div class="text-center">
      <p class="eyebrow">
        {hairlab.reels.eyebrow}
      </p>
      <h2 class="h2">
        {hairlab.reels.title}
      </h2>
    </div>
    <div class="reels__grid">
      {hairlab.reels.items.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="reel-card"
        >
          {item.text}
        </a>
      ))}
    </div>
    <p class="caption" style="text-align: center; margin-top: 24px;">
      {hairlab.reels.caption}
    </p>
  </Container>
</Section>
