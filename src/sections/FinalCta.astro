---
import { hairlab } from '../data/hairlab';
import Button from '../ui/Button.astro';
---

<section class="final-cta">
  <div class="container">
    <h2 class="h2" style="color: var(--color-cream);">
      {hairlab.finalCta.title}
    </h2>
    <Button variant="light" data-cta-id="final" style="margin-top: 32px;">
      {hairlab.finalCta.ctaText}
    </Button>
    <p class="caption" style="opacity: 0.7; margin-top: 24px;">
      {hairlab.finalCta.note}
    </p>
  </div>
</section>
