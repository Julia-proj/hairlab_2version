---
import { hairlab } from '../data/hairlab';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
---

<Section alt>
  <Container>
    <div class="text-center">
      <p class="eyebrow">
        {hairlab.beforeAfter.eyebrow}
      </p>
      <h2 class="h2">
        {hairlab.beforeAfter.title}
      </h2>
    </div>
    <div style="display: grid; gap: 24px; margin-top: 48px;">
      {hairlab.beforeAfter.images.map((img) => (
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          width="600"
          height="400"
        />
      ))}
    </div>
    <p class="caption" style="text-align: center; margin-top: 24px;">
      {hairlab.beforeAfter.caption}
    </p>
  </Container>
</Section>
