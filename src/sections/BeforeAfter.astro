---
import { hairlab } from '../data/hairlab';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
---

<Section alt>
  <Container>
    <div class="text-center">
      <p class="eyebrow">
        {hairlab.beforeAfter.eyebrow}
      </p>
      <h2 class="h2">
        {hairlab.beforeAfter.title}
      </h2>
    </div>
    <div class="beforeafter__grid">
      {hairlab.beforeAfter.images.map((img) => (
        <figure class="beforeafter__card">
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            width="800"
            height="1000"
          />
        </figure>
      ))}
    </div>
    <p class="caption" style="text-align: center; margin-top: 24px;">
      {hairlab.beforeAfter.caption}
    </p>
  </Container>
</Section>
