---
import { hairlab } from '../data/hairlab';
import Button from '../ui/Button.astro';
import { links } from '../lib/links';
---

<section class="hero">
  <img
    class="hero__bg"
    src={hairlab.hero.image.src}
    alt={hairlab.hero.image.alt}
    fetchpriority="high"
    width="1080"
    height="1551"
  />
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="container hero__content">
    <div class="hero__copy">
      <p class="eyebrow">
        {hairlab.hero.eyebrow}
      </p>
      <h1 class="display">
        {hairlab.hero.title}
      </h1>
      <p class="body hero__subtitle">
        {hairlab.hero.subtitle}
      </p>
      <div class="hero__cta-row">
        <Button variant="light" href={links.offer('hero')} data-cta-id="hero">
          {hairlab.hero.primaryCta}
        </Button>
      </div>
      <a
        href={links.quiz('hero')}
        class="hero__test-link"
        data-cta-id="hero-test"
        target="_blank"
        rel="noopener noreferrer"
      >
        {hairlab.hero.testCta.text}
      </a>
      <p class="caption hero__micro">
        {hairlab.hero.micro}
      </p>
      <p class="hero__social-proof">
        ★ 5000+ клиенток · 6 лет практики · Студия в Мадриде
      </p>
    </div>
  </div>
</section>
