---
import { hairlab } from '../data/hairlab';
import { links } from '../lib/links';
---

<nav class="nav">
  <div class="container nav__inner">
    <a href="#top" class="nav__logo">
      {hairlab.nav.logo}
    </a>
    <div class="nav__links">
      {hairlab.nav.links.map((link) => (
        <a href={link.href}>
          {link.text}
        </a>
      ))}
    </div>
    <div class="nav__actions">
      <a
        href={links.quiz('nav')}
        class="nav__test"
        data-cta-id="nav-test"
        target="_blank"
        rel="noopener noreferrer"
      >
        {hairlab.nav.testCta.text}
      </a>
      <a href={links.offer('nav')} class="nav__cta" data-cta-id="nav">
        {hairlab.nav.ctaText}
      </a>
    </div>
  </div>
</nav>
