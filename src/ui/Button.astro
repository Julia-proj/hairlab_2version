---
interface Props {
  variant?: 'primary' | 'ghost' | 'light';
  size?: 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  'data-cta-id'?: string;
  class?: string;
  style?: string;
}

const {
  variant = 'primary',
  size = 'lg',
  href,
  target,
  rel,
  'data-cta-id': ctaId,
  class: className,
  style,
} = Astro.props;

const finalHref = href || '#';

const variantClass = variant === 'primary' ? 'btn--primary' : variant === 'ghost' ? 'btn--ghost' : 'btn--light';
const sizeClass = size === 'md' ? 'btn--md' : '';
const classes = `btn ${variantClass} ${sizeClass} ${className || ''}`;
---

<a
  href={finalHref}
  class={classes}
  target={target}
  rel={rel}
  data-cta-id={ctaId}
  style={style}
>
  <slot />
</a>
