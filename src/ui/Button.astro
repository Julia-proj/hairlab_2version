---
interface Props {
  variant?: 'primary' | 'ghost' | 'light';
  size?: 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  'data-cta-id'?: string;
  class?: string;
  style?: string;
}

const {
  variant = 'primary',
  size = 'lg',
  href,
  target,
  rel,
  'data-cta-id': ctaId,
  class: className,
  style,
} = Astro.props;

const checkoutUrl = import.meta.env.PUBLIC_CHECKOUT_URL || '#';
const finalHref = href || checkoutUrl;

const variantClass = variant === 'primary' ? 'btn--primary' : variant === 'ghost' ? 'btn--ghost' : 'btn--light';
const sizeClass = size === 'md' ? 'btn--md' : '';
const classes = `btn ${variantClass} ${sizeClass} ${className || ''}`;
---

{finalHref.startsWith('http') ? (
  <a
    href={finalHref}
    class={classes}
    target={target || '_blank'}
    rel={rel || 'noopener noreferrer'}
    data-cta-id={ctaId}
    style={style}
  >
    <slot />
  </a>
) : (
  <a
    href={finalHref}
    class={classes}
    data-cta-id={ctaId}
    style={style}
  >
    <slot />
  </a>
)}
