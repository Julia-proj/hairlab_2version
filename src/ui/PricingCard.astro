---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  oldPrice: string;
  newPrice: string;
  note: string;
  ctaText: string;
  ctaId: string;
  ctaHref: string;
}

const { eyebrow, oldPrice, newPrice, note, ctaText, ctaId, ctaHref } = Astro.props;
---

<div class="pricing-card">
  <p class="eyebrow">
    {eyebrow}
  </p>
  <p class="pricing-card__old">
    {oldPrice}
  </p>
  <p class="pricing-card__new">
    {newPrice}
  </p>
  <p class="caption pricing-card__note">
    {note}
  </p>
  <Button variant="primary" href={ctaHref} data-cta-id={ctaId} class="w-full">
    {ctaText}
  </Button>
</div>
